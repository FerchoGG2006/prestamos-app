{
  "name": "prestamos-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "typescript": "~6.0.3",
    "wait-on": "^9.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "desktop": "concurrently -k \"npx expo start --web --port 8081\" \"wait-on tcp:8081 && electron electron/main.js\"",
    "electron:dev": "electron electron/main.js"
  },
  "main": "electron/main.js",
  "private": true
}
